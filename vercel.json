{
  "functions": {
    "api/reddit.js": {
      "maxDuration": 30
    },
    "api/news.js": {
      "maxDuration": 15
    },
    "api/twitter.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
